{
	"name": "effect-watch-plus",
	"version": "1.0.0",
	"description": "Additive Effect filesystem watch options and native or scoped-ripgrep enumeration",
	"main": "./effect-watch-plus.ts",
	"types": "./effect-watch-plus.ts",
	"exports": {
		"./inventory": {
			"types": "./src/Inventory.ts",
			"default": "./src/Inventory.ts"
		},
		".": {
			"types": "./effect-watch-plus.ts",
			"default": "./effect-watch-plus.ts"
		},
		"./package.json": "./package.json"
	},
	"files": ["src", "effect-watch-plus.ts", "README.md", "IGNORE.md", "ENUMERATION.md", "doc/inventory"],
	"sideEffects": false,
	"scripts": {
		"build": "tsgo --noEmit -p tsconfig.json",
		"typecheck": "tsgo --noEmit -p tsconfig.json",
		"test": "bun test ./test"
	},
	"peerDependencies": {
		"effect": "4.0.1"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.1",
		"@effect/platform-node-shared": "4.0.1",
		"@types/bun": "1.4.0",
		"@types/node": "26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20251207.1",
		"effect": "4.0.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rektide/effect-watch-plus.git"
	},
	"keywords": [],
	"author": "rektide de la faye",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/rektide/effect-watch-plus/issues"
	},
	"homepage": "https://github.com/rektide/effect-watch-plus#readme",
	"type": "module",
	"dependencies": {
		"glob": "13.0.6",
		"minimatch": "10.0.3"
	}
}
